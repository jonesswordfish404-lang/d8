<script>
/* ===== D8 MP3→MP4 · WebCodecs engine (MP4 or WebM, no download) ===== */
(() => {
  "use strict";
  const $ = id => document.getElementById(id);
  const state = { audioFile:null, imageFile:null, imageBitmap:null, audioBuffer:null, fit:"contain", res:720, bg:"202020", busy:false };
  let plan=null; // {container, ext, vcodec, muxV, acodec, muxA}

  const audioIn=$("audioIn"), imageIn=$("imageIn"), dropAudio=$("dropAudio"), dropImage=$("dropImage");
  const audioName=$("audioName"), audioDesc=$("audioDesc"), imageName=$("imageName"), imageDesc=$("imageDesc");
  const previewCanvas=$("preview"), previewEmpty=$("previewEmpty");
  const goBtn=$("goBtn"), statusEl=$("status");
  const progWrap=$("progWrap"), segbar=$("segbar"), progLabel=$("progLabel"), progTime=$("progTime");
  const result=$("result"), resultVideo=$("resultVideo"), dlLink=$("dlLink");
  const engineDot=$("engineDot"), engineLabel=$("engineLabel");

  const fmt = s => { s=Math.max(0,Math.floor(s||0)); const m=Math.floor(s/60),ss=String(s%60).padStart(2,"0"); return m+":"+ss; };
  const setStatus = (m,c="") => { statusEl.textContent=m; statusEl.className="status"+(c?" "+c:""); };
  const SEGS=24;
  for(let i=0;i<SEGS;i++) segbar.appendChild(document.createElement("i"));
  const setProgress = f => { const n=Math.round(Math.min(1,Math.max(0,f))*SEGS); const k=segbar.children; for(let i=0;i<SEGS;i++) k[i].classList.toggle("fill", i<n); };

  function setEngine(kind,msg){
    if(kind==="fast"){ engineDot.className="dot on"; engineLabel.textContent=msg||"Fast engine ready"; }
    else if(kind==="fallback"){ engineDot.className="dot off"; engineLabel.textContent=msg||"Real‑time mode"; }
    else { engineDot.className="spin"; engineLabel.textContent=msg||"Checking engine…"; }
  }

  async function okV(codec,W,H){ try{ const s=await VideoEncoder.isConfigSupported({codec,width:W,height:H,bitrate:2500000,framerate:5}); return !!(s&&s.supported); }catch(e){ return false; } }
  async function okA(codec,ch,rate){ try{ const s=await AudioEncoder.isConfigSupported({codec,sampleRate:rate,numberOfChannels:ch,bitrate:128000}); return !!(s&&s.supported); }catch(e){ return false; } }

  async function pickH264(W,H){
    for(const c of ['avc1.42E01E','avc1.42001F','avc1.4D401F','avc1.42E028','avc1.4D4028','avc1.640028']){ if(await okV(c,W,H)) return c; }
    return null;
  }

  // Decide the best codec/container this device can actually encode
  async function negotiate(W,H){
    // 1) MP4: H.264 video + AAC audio (best compatibility if hardware allows)
    const h264 = await pickH264(W,H);
    if(h264 && await okA('mp4a.40.2',2,44100))
      return { container:'mp4', ext:'mp4', vcodec:h264, muxV:'avc', acodec:'mp4a.40.2', muxA:'aac' };
    // 2) WebM: VP9/VP8 video + Opus audio (software-encodable in Chrome)
    let vp=null, mv=null;
    if(await okV('vp09.00.10.08',W,H)){ vp='vp09.00.10.08'; mv='V_VP9'; }
    else if(await okV('vp8',W,H)){ vp='vp8'; mv='V_VP8'; }
    if(vp && await okA('opus',2,48000))
      return { container:'webm', ext:'webm', vcodec:vp, muxV:mv, acodec:'opus', muxA:'A_OPUS' };
    return null;
  }

  // capability probe — instant, no download
  (async () => {
    try{
      if(!('VideoEncoder' in window) || !('AudioEncoder' in window) || !('VideoFrame' in window) || !('AudioData' in window) || !window.Mp4Muxer || !window.WebMMuxer){
        plan=null; setEngine("fallback","Real‑time mode (WebCodecs unsupported)"); return;
      }
      plan = await negotiate(1280,720); // probe at 720p; re-checked at render for 1080p
      if(plan) setEngine("fast","Fast engine ready ("+plan.ext.toUpperCase()+")");
      else setEngine("fallback","Real‑time mode (no encoder)");
    }catch(e){ plan=null; setEngine("fallback","Real‑time mode"); }
  })();

  function wireSeg(id, attr, cb){
    const w=$(id);
    w.addEventListener("click", e=>{ const b=e.target.closest("button"); if(!b) return;
      [...w.children].forEach(x=>x.classList.remove("on")); b.classList.add("on"); cb(b.getAttribute(attr)); });
  }
  wireSeg("fitSeg","data-fit", v=>{ state.fit=v; drawPreview(); });
  wireSeg("resSeg","data-res", v=>{ state.res=parseInt(v,10); drawPreview(); });
  wireSeg("bgSeg","data-bg", v=>{ state.bg=v; drawPreview(); });

  audioIn.addEventListener("change", async e=>{
    const f=e.target.files[0]; if(!f) return;
    state.audioFile=f; state.audioBuffer=null;
    audioName.textContent=f.name; audioDesc.textContent="Decoding…"; dropAudio.classList.add("filled");
    try{
      const buf=await f.arrayBuffer();
      const AC=window.AudioContext||window.webkitAudioContext; const ctx=new AC();
      const dec=await ctx.decodeAudioData(buf.slice(0)); ctx.close();
      state.audioBuffer=dec;
      audioDesc.textContent=fmt(dec.duration)+" · "+dec.numberOfChannels+"ch · "+Math.round(f.size/1024)+" KB";
      setStatus("");
    }catch(err){ audioDesc.textContent="Could not decode"; setStatus("Audio decode failed — try MP3/M4A/WAV.","err"); }
    refreshReady();
  });

  imageIn.addEventListener("change", async e=>{
    const f=e.target.files[0]; if(!f) return;
    state.imageFile=f; imageName.textContent=f.name; imageDesc.textContent="Loading…"; dropImage.classList.add("filled");
    try{
      if(state.imageBitmap && state.imageBitmap.close) state.imageBitmap.close();
      let bmp;
      if(window.createImageBitmap) bmp=await createImageBitmap(f);
      else bmp=await new Promise((res,rej)=>{const i=new Image();i.onload=()=>res(i);i.onerror=rej;i.src=URL.createObjectURL(f);});
      state.imageBitmap=bmp;
      const w=bmp.width||bmp.naturalWidth,h=bmp.height||bmp.naturalHeight;
      imageDesc.textContent=w+"×"+h+" · "+Math.round(f.size/1024)+" KB";
      drawPreview(); setStatus("");
    }catch(err){ imageDesc.textContent="Could not load"; setStatus("Image load failed — try JPG/PNG.","err"); }
    refreshReady();
  });

  function frameDims(){ let H=state.res, W=Math.round(H*16/9); if(W%2)W++; if(H%2)H++; return {W,H}; }
  function drawFrame(ctx,W,H){
    ctx.fillStyle="#"+state.bg; ctx.fillRect(0,0,W,H);
    const bmp=state.imageBitmap; if(!bmp) return;
    const iw=bmp.width||bmp.naturalWidth, ih=bmp.height||bmp.naturalHeight;
    const scale = state.fit==="cover" ? Math.max(W/iw,H/ih) : Math.min(W/iw,H/ih);
    const dw=iw*scale, dh=ih*scale;
    ctx.drawImage(bmp,(W-dw)/2,(H-dh)/2,dw,dh);
  }
  function drawPreview(){
    if(!state.imageBitmap){ previewCanvas.style.display="none"; previewEmpty.style.display=""; return; }
    const {W,H}=frameDims(); previewCanvas.width=W; previewCanvas.height=H;
    previewCanvas.style.display="block"; previewEmpty.style.display="none";
    drawFrame(previewCanvas.getContext("2d"),W,H);
  }
  function refreshReady(){ goBtn.disabled = !(state.audioBuffer && state.imageBitmap) || state.busy; }

  goBtn.addEventListener("click", async ()=>{
    if(state.busy || !(state.audioBuffer && state.imageBitmap)) return;
    state.busy=true; refreshReady(); goBtn.textContent="Rendering…";
    result.classList.remove("show"); progWrap.classList.add("show"); setProgress(0); progTime.textContent="0%"; setStatus("");
    try{
      if(plan){
        try{ await renderFast(); }
        catch(err){ console.warn("WebCodecs path failed, falling back:",err);
          setStatus("Fast encode hit a snag ("+(err&&err.message?err.message:err)+") — finishing in real time.","warn");
          await renderRealtime(); }
      } else {
        await renderRealtime();
      }
    }catch(err){
      setStatus("Render failed: "+(err&&err.message?err.message:err),"err");
      progWrap.classList.remove("show");
    }finally{
      state.busy=false; goBtn.textContent="Render MP4"; refreshReady();
    }
  });

  // resample an AudioBuffer to a target rate (needed for Opus @48k)
  async function resampleTo(buffer, rate){
    if(buffer.sampleRate===rate) return buffer;
    const oac=new OfflineAudioContext(buffer.numberOfChannels, Math.ceil(buffer.duration*rate), rate);
    const src=oac.createBufferSource(); src.buffer=buffer; src.connect(oac.destination); src.start();
    return await oac.startRendering();
  }

  // FAST: WebCodecs encode of a still frame + audio, muxed to MP4 or WebM
  async function renderFast(){
    const {W,H}=frameDims();
    // re-negotiate for the chosen resolution (probe was at 720p)
    let p = plan;
    if(state.res!==720){ const r=await negotiate(W,H); if(r) p=r; }
    if(!p) throw new Error("no supported encoder for "+W+"x"+H);

    let ab=state.audioBuffer;
    const targetRate = (p.acodec==='opus') ? 48000 : ab.sampleRate;
    if(p.acodec==='opus') ab = await resampleTo(ab, 48000);
    const sampleRate=ab.sampleRate, channels=Math.min(2, ab.numberOfChannels), duration=ab.duration;

    progLabel.textContent="Encoding (fast)…";

    const canvas=document.createElement("canvas"); canvas.width=W; canvas.height=H;
    const cctx=canvas.getContext("2d",{alpha:false}); drawFrame(cctx,W,H);

    const isMp4 = p.container==='mp4';
    const M = isMp4 ? Mp4Muxer : WebMMuxer;
    const muxCfg = {
      target:new M.ArrayBufferTarget(),
      video:{ codec:p.muxV, width:W, height:H },
      audio:{ codec:p.muxA, numberOfChannels:channels, sampleRate },
    };
    if(isMp4) muxCfg.fastStart='in-memory';
    const muxer=new M.Muxer(muxCfg);

    let encErr=null;
    const venc=new VideoEncoder({ output:(chunk,meta)=>{ try{muxer.addVideoChunk(chunk,meta);}catch(e){encErr=e;} }, error:e=>{encErr=e;} });
    venc.configure({ codec:p.vcodec, width:W, height:H, bitrate:2500000, framerate:5 });
    const aenc=new AudioEncoder({ output:(chunk,meta)=>{ try{muxer.addAudioChunk(chunk,meta);}catch(e){encErr=e;} }, error:e=>{encErr=e;} });
    aenc.configure({ codec:p.acodec, sampleRate, numberOfChannels:channels, bitrate:160000 });

    // video: one still frame across the duration
    const fps=5, totalFrames=Math.max(1, Math.round(duration*fps)), frameDurUs=Math.round(1e6/fps);
    for(let i=0;i<totalFrames;i++){
      if(encErr) throw encErr;
      const vf=new VideoFrame(canvas,{ timestamp:i*frameDurUs, duration:frameDurUs });
      venc.encode(vf,{ keyFrame:(i===0) });
      vf.close();
      if(venc.encodeQueueSize>8) await new Promise(r=>setTimeout(r,0));
      if((i & 7)===0){ const f=i/totalFrames; setProgress(0.05+0.50*f); progTime.textContent=Math.round(f*55)+"%"; }
    }
    await venc.flush();

    // audio
    const total=ab.length, chunkFrames=8192, chans=[];
    for(let c=0;c<channels;c++) chans.push(ab.getChannelData(c));
    for(let off=0; off<total; off+=chunkFrames){
      if(encErr) throw encErr;
      const n=Math.min(chunkFrames, total-off);
      const planar=new Float32Array(n*channels);
      for(let c=0;c<channels;c++) planar.set(chans[c].subarray(off,off+n), c*n);
      const ad=new AudioData({ format:'f32-planar', sampleRate, numberOfFrames:n, numberOfChannels:channels, timestamp:Math.round(off/sampleRate*1e6), data:planar });
      aenc.encode(ad); ad.close();
      if(aenc.encodeQueueSize>8) await new Promise(r=>setTimeout(r,0));
      const f=off/total; setProgress(0.55+0.35*f); progTime.textContent=Math.round(55+f*35)+"%";
    }
    await aenc.flush();

    if(encErr) throw encErr;
    muxer.finalize();
    const {buffer}=muxer.target;
    try{ venc.close(); aenc.close(); }catch(_){}
    finish(new Blob([buffer],{type:isMp4?'video/mp4':'video/webm'}), p.ext);
  }

  // FALLBACK: real-time canvas + MediaRecorder
  async function renderRealtime(){
    progLabel.textContent="Rendering in real time…";
    const types=["video/mp4;codecs=avc1.42E01E,mp4a.40.2","video/mp4","video/webm;codecs=vp9,opus","video/webm"];
    let mime="", ext="webm";
    for(const t of types){ if(window.MediaRecorder&&MediaRecorder.isTypeSupported(t)){ mime=t; ext=t.includes("mp4")?"mp4":"webm"; break; } }
    if(ext==="webm") setStatus("Saving WebM (plays on Android; D8Engine remuxes to MP4).","warn");
    let wakeLock=null; try{ if(navigator.wakeLock) wakeLock=await navigator.wakeLock.request("screen"); }catch(_){}
    const {W,H}=frameDims();
    const canvas=document.createElement("canvas"); canvas.width=W; canvas.height=H;
    const cctx=canvas.getContext("2d"); drawFrame(cctx,W,H);
    const vStream=canvas.captureStream(15);
    const AC=window.AudioContext||window.webkitAudioContext; const ctx=new AC(); if(ctx.state==="suspended") await ctx.resume();
    const src=ctx.createBufferSource(); src.buffer=state.audioBuffer;
    const dest=ctx.createMediaStreamDestination(); src.connect(dest);
    const mixed=new MediaStream([...vStream.getVideoTracks(),...dest.stream.getAudioTracks()]);
    const opts={videoBitsPerSecond:2000000,audioBitsPerSecond:192000}; if(mime) opts.mimeType=mime;
    const rec=new MediaRecorder(mixed,opts); const chunks=[];
    rec.ondataavailable=e=>{ if(e.data&&e.data.size) chunks.push(e.data); };
    const dur=state.audioBuffer.duration, start=ctx.currentTime; let raf=0;
    const tick=()=>{ drawFrame(cctx,W,H); const el=ctx.currentTime-start; setProgress(el/dur); progTime.textContent=Math.round(el/dur*100)+"%"; raf=requestAnimationFrame(tick); };
    const done=new Promise((res,rej)=>{ rec.onstop=res; rec.onerror=e=>rej(e.error||new Error("Recorder error")); });
    rec.start(1000); src.start(); raf=requestAnimationFrame(tick);
    src.onended=()=>setTimeout(()=>{ if(rec.state!=="inactive") rec.stop(); },250);
    await done; cancelAnimationFrame(raf);
    try{ if(ctx.state!=="closed") ctx.close(); }catch(_){}
    try{ if(wakeLock) await wakeLock.release(); }catch(_){}
    finish(new Blob(chunks,{type:mime||("video/"+ext)}), ext);
  }

  function finish(blob, ext){
    const url=URL.createObjectURL(blob);
    const base=(state.audioFile.name.replace(/\.[^.]+$/,""))||"output";
    const fname=base+"_D8."+ext;
    resultVideo.src=url; dlLink.href=url; dlLink.download=fname; dlLink.textContent="⬇ Save "+fname;
    result.classList.add("show");
    setProgress(1); progTime.textContent="100%"; progLabel.textContent="Done";
    setStatus("Rendered "+fname+" · "+(blob.size/1048576).toFixed(1)+" MB · "+ext.toUpperCase(),"ok");
  }
})();
</script>
