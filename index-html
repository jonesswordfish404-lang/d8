<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#202020">
<title>D8 · MP3 → MP4</title>
<style>
  :root{
    --bg:#202020; --panel:#2d2d30; --panel2:#262629;
    --cyan:#0096C8; --blue:#375AD2; --violet:#7846D2;
    --text:gainsboro; --muted:#8a8a90; --line:#3a3a3f;
    --ok:#3ecb7a; --warn:#e6b54a; --err:#e05555;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0}
  body{background:var(--bg);color:var(--text);font-family:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;font-size:15px;line-height:1.45;padding:16px 14px 40px;max-width:560px;margin:0 auto;min-height:100vh}
  header{display:flex;align-items:center;gap:12px;margin-bottom:14px}
  .logo{width:46px;height:46px;border-radius:14px;flex:0 0 auto;background:linear-gradient(135deg,var(--cyan),var(--blue) 55%,var(--violet));display:flex;align-items:center;justify-content:center;font-weight:700;font-size:20px;color:#fff;letter-spacing:-1px;box-shadow:0 4px 14px rgba(55,90,210,.35)}
  h1{font-size:18px;margin:0;font-weight:600}
  .sub{font-size:12px;color:var(--muted);margin-top:1px}
  .chip{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;padding:5px 10px;border-radius:20px;background:var(--panel2);border:1px solid var(--line);color:var(--muted);margin-bottom:14px}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--warn);flex:0 0 auto}
  .dot.on{background:var(--ok)} .dot.off{background:var(--err)}
  .spin{width:9px;height:9px;border:2px solid var(--line);border-top-color:var(--cyan);border-radius:50%;animation:sp .7s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:14px}
  .card h2{font-size:12px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:var(--muted);margin:0 0 10px}
  .drop{display:flex;align-items:center;gap:12px;background:var(--panel2);border:1px dashed var(--line);border-radius:12px;padding:14px;cursor:pointer;transition:border-color .15s}
  .drop:active{border-color:var(--cyan)}
  .drop.filled{border-style:solid;border-color:var(--cyan)}
  .drop .ico{width:38px;height:38px;flex:0 0 auto;border-radius:10px;background:linear-gradient(135deg,var(--cyan),var(--blue));display:flex;align-items:center;justify-content:center;font-size:18px}
  .drop .meta{min-width:0}
  .drop .t{font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .drop .d{font-size:11.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  input[type=file]{display:none}
  .previewWrap{margin-top:12px;border-radius:12px;overflow:hidden;background:var(--bg);border:1px solid var(--line);aspect-ratio:16/9;display:flex;align-items:center;justify-content:center}
  #preview{width:100%;height:100%;display:block}
  .previewEmpty{color:var(--muted);font-size:12.5px}
  .opt-row{margin-bottom:14px}.opt-row:last-child{margin-bottom:0}
  .opt-label{font-size:12.5px;color:var(--muted);margin-bottom:7px}
  .seg{display:flex;background:var(--panel2);border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .seg button{flex:1;background:transparent;color:var(--muted);border:0;padding:9px 4px;font-size:13px;font-family:inherit;cursor:pointer;transition:background .15s,color .15s}
  .seg button.on{background:linear-gradient(135deg,var(--cyan),var(--blue));color:#fff;font-weight:600}
  .go{width:100%;border:0;border-radius:12px;padding:15px;font-family:inherit;font-size:16px;font-weight:600;color:#fff;cursor:pointer;background:linear-gradient(135deg,var(--cyan),var(--blue) 55%,var(--violet));box-shadow:0 4px 16px rgba(120,70,210,.3);transition:opacity .15s,transform .05s}
  .go:active{transform:translateY(1px)}
  .go:disabled{opacity:.45;cursor:not-allowed;box-shadow:none}
  .progWrap{margin-top:14px;display:none}.progWrap.show{display:block}
  .segbar{display:flex;gap:3px;height:14px;margin-bottom:8px}
  .segbar i{flex:1;border-radius:3px;background:var(--panel2);transition:background .2s}
  .segbar i.fill{background:linear-gradient(90deg,var(--cyan),var(--violet))}
  .progText{display:flex;justify-content:space-between;font-size:12px;color:var(--muted)}
  .result{display:none;margin-top:6px}.result.show{display:block}
  .result video{width:100%;border-radius:12px;background:#000;margin-bottom:12px;display:block}
  .dl{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;text-decoration:none;text-align:center;border-radius:12px;padding:14px;font-size:15px;font-weight:600;color:#fff;background:linear-gradient(135deg,var(--ok),#2a9e5f)}
  .status{font-size:12.5px;margin-top:10px;color:var(--muted);min-height:16px}
  .status.err{color:var(--err)}.status.warn{color:var(--warn)}.status.ok{color:var(--ok)}
  footer{text-align:center;font-size:11px;color:#555;margin-top:22px}
</style>
</head>
<body>
<header>
  <div class="logo">D8</div>
  <div><h1>MP3 → MP4</h1><div class="sub">Still image + audio · on‑device, no download</div></div>
</header>

<div class="chip" id="engineChip"><span class="spin" id="engineDot"></span><span id="engineLabel">Checking engine…</span></div>

<div class="card">
  <h2>Sources</h2>
  <label class="drop" id="dropAudio" for="audioIn">
    <div class="ico">♪</div>
    <div class="meta"><div class="t" id="audioName">Choose audio</div><div class="d" id="audioDesc">MP3, M4A, WAV, OGG…</div></div>
  </label>
  <input type="file" id="audioIn" accept="audio/*">
  <label class="drop" id="dropImage" for="imageIn" style="margin-top:10px">
    <div class="ico">▦</div>
    <div class="meta"><div class="t" id="imageName">Choose image</div><div class="d" id="imageDesc">JPG, PNG, WebP…</div></div>
  </label>
  <input type="file" id="imageIn" accept="image/*">
  <div class="previewWrap"><span class="previewEmpty" id="previewEmpty">Preview</span><canvas id="preview" style="display:none"></canvas></div>
</div>

<div class="card">
  <h2>Options</h2>
  <div class="opt-row"><div class="opt-label">Image fit</div>
    <div class="seg" id="fitSeg"><button data-fit="contain" class="on">Fit (letterbox)</button><button data-fit="cover">Fill (crop)</button></div></div>
  <div class="opt-row"><div class="opt-label">Resolution</div>
    <div class="seg" id="resSeg"><button data-res="720" class="on">720p</button><button data-res="1080">1080p</button></div></div>
  <div class="opt-row"><div class="opt-label">Frame background (letterbox)</div>
    <div class="seg" id="bgSeg"><button data-bg="202020" class="on">D8 dark</button><button data-bg="000000">Black</button><button data-bg="ffffff">White</button></div></div>
</div>

<div class="card">
  <button class="go" id="goBtn" disabled>Render MP4</button>
  <div class="progWrap" id="progWrap"><div class="segbar" id="segbar"></div>
    <div class="progText"><span id="progLabel">Rendering…</span><span id="progTime">0%</span></div></div>
  <div class="status" id="status"></div>
  <div class="result" id="result"><video id="resultVideo" controls playsinline></video><a class="dl" id="dlLink" download>⬇ Save video</a></div>
</div>

<footer>D8 · Digital8Dreamz · renders locally, nothing uploaded</footer>

